html 
    head 
        title OAuth2/OpenID login demo
    body
        if username
            h1 Welcome #{username}
        ul 
            li: a(href='/', title='Home') Home
            li Broj propusnica: #{passCount}
            li Broj aktivnih propusnica: #{activePassCount}
            if username
                li: form(action="/logout", method="post")
                    input(type="submit", value="Logout " + username)
                if passes.length > 0
                    table
                        thead
                            tr
                                th Ime
                                th Dokument
                                th Vrijeme izdavanja
                                th Status
                                th Akcija
                        tbody
                            each pass in passes
                                tr
                                    td #{pass.name}
                                    td #{pass.document}
                                    td #{new Date(pass.issued_at).toLocaleString()}
                                    td #{pass.status}
                                    td 
                                        if pass.status === 'ACTIVE'
                                            form(action=`/passes/${pass.id}/cancel`, method="post")
                                                button(type="submit") Poništi
                                        form(action=`/passes/${pass.id}/delete`, method="post")
                                            button(type="submit") Obriši
                else
                    p Nema propusnica.
            else
                li: a(href='/login') Login